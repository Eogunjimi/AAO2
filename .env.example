# Endpoint that receives lead/enquiry submissions (POST, JSON body).
# When unset the app runs in "demo" mode: submissions are validated, logged and
# resolved locally so the UI can be developed without a backend. Visitors can
# still reach us — every form offers a WhatsApp hand-off carrying their details.
#
# Under Next.js, variables exposed to the browser must be prefixed with
# `NEXT_PUBLIC_`. Server Route Handlers / Server Actions use the unprefixed
# name. The compatibility helper `src/lib/env.js` accepts both prefixes so
# existing `VITE_LEAD_ENDPOINT` deployments keep working.
#
# The POSTed body looks like:
#   {
#     "name": "Ada Bakare",
#     "phone": "+2348105743694",   // normalised to E.164
#     "phoneInput": "0810 574 3694", // exactly what they typed
#     "email": "ada@example.com",
#     "service": "solar-inverter",
#     "location": "Lekki Phase 1",
#     "message": "…",
#     "source": "contact-form",     // or "hero-quote-form"
#     "submittedAt": "2026-10-01T09:00:00.000Z",
#     "pageUrl": "https://www.aaoengineering.com/services/cctv"
#   }
#
# Respond 2xx to confirm. Return {"reference":"AAO-123"} to show the visitor
# your own reference; otherwise one is generated client-side.
NEXT_PUBLIC_LEAD_ENDPOINT=

# Absolute site URL, used for canonical tags and structured data.
NEXT_PUBLIC_SITE_URL=https://www.aaoengineering.com
